# Database (PostgreSQL qua docker-compose)
DATABASE_URL="postgresql://masoi:masoi_dev_password@localhost:5433/masoi?schema=public"

# Redis (qua docker-compose)
REDIS_URL="redis://localhost:6380"

# Server
# Northflank và các nền tảng container tự gán PORT.
PORT=4100
SERVER_PORT=4100
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Web: URL của server API/Socket.IO mà trình duyệt gọi tới
NEXT_PUBLIC_SERVER_URL=http://localhost:4100

# Giới hạn chat chống spam
CHAT_MAX_LENGTH=300
CHAT_RATE_LIMIT_COUNT=5
CHAT_RATE_LIMIT_WINDOW_MS=5000
