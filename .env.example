# Database (PostgreSQL qua docker-compose)
DATABASE_URL="postgresql://masoi:masoi_dev_password@localhost:5433/masoi?schema=public"

# Redis (qua docker-compose)
REDIS_URL="redis://localhost:6380"

# Server
# Render và các nền tảng container tương tự tự gán PORT.
PORT=4100
SERVER_PORT=4100
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Web: URL của server API/Socket.IO mà trình duyệt gọi tới
NEXT_PUBLIC_SERVER_URL=http://localhost:4100

# Giới hạn chat chống spam
CHAT_MAX_LENGTH=300
CHAT_RATE_LIMIT_COUNT=5
CHAT_RATE_LIMIT_WINDOW_MS=5000

# Giới hạn tạo người chơi, khoá theo IP. Đây là endpoint duy nhất không cần
# đăng nhập, và mọi rate limit khác đều khoá theo playerId - nên không chặn ở
# đây thì lấy playerId mới là có bộ giới hạn mới.
SIGNUP_RATE_LIMIT_COUNT=10
SIGNUP_RATE_LIMIT_WINDOW_MS=60000

# Số hop proxy tin được (app.set("trust proxy", ...)).
# 1 = chạy sau proxy như Render (mặc định): req.ip lấy từ X-Forwarded-For.
# 0 = tự host, phơi cổng thẳng ra Internet: KHÔNG tin header, dùng IP socket.
TRUST_PROXY=1

# Bot AI (tuỳ chọn). Thiếu key thì bot chạy ngẫu nhiên như cũ.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
BOT_AI_ENABLED=true
# Một ván 8 bot x 6 vòng tốn khoảng 126 lượt kể từ khi có phiên toà.
BOT_AI_MAX_CALLS_PER_GAME=180

# Voice chat (LiveKit Cloud). Bỏ trống cả ba để tắt hẳn voice.
# Thiếu một nửa thì server ném lỗi lúc khởi động thay vì âm thầm tắt.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Vào tên room (masoi-<env>-<CODE>) để dev không đụng production. Mặc định "dev".
LIVEKIT_ENV=dev
