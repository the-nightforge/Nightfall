# ops/vps/.env.production.example — Template for /opt/masoi/.env on the VPS.
#
# Setup (on the VPS, as root or deploy):
#   sudo mkdir -p /opt/masoi
#   sudo cp ops/vps/.env.production.example /opt/masoi/.env
#   sudo chmod 600 /opt/masoi/.env
#   sudo nano /opt/masoi/.env   # replace EVERY REPLACE_ME below
#
# Rules:
#   - NEVER commit the real /opt/masoi/.env. No real secrets in this file.
#   - The password inside DATABASE_URL MUST match POSTGRES_PASSWORD.
#   - `masoi_dev_password` must appear NOWHERE in production (03-deploy.sh
#     refuses to deploy if it finds it).
#   - CORS_ORIGIN must be the exact Vercel origin, never `*` in production
#     (the server throws at startup if it is `*`).

# Strong random password for the postgres superuser account `masoi`.
# Generate:  openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_ME_strong_random_password

# App -> Postgres. Host `postgres` is the compose service name (internal DNS).
DATABASE_URL=postgresql://masoi:REPLACE_ME_strong_random_password@postgres:5432/masoi?schema=public

# App -> Redis. No password (localhost-only inside the compose network).
REDIS_URL=redis://redis:6379

# The app listens on $PORT (config.ts: PORT wins over SERVER_PORT, else 4000).
# Keep 4100 unless you also update Nginx + the compose port mapping.
PORT=4100
NODE_ENV=production

# Exact frontend origin, e.g. https://ma-soi-online.vercel.app
CORS_ORIGIN=https://REPLACE_ME_your-app.vercel.app

# Behind Nginx: trust 1 proxy hop so req.ip / rate limits see the real client.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Optional: BOT AI (Gemini). Leave all empty = bots play heuristically.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# BOT_AI_ENABLED=true
# BOT_AI_MAX_CALLS_PER_GAME=180

# ---------------------------------------------------------------------------
# Optional: voice chat (LiveKit). Leave ALL THREE empty = voice disabled.
# Filling only some of them makes the server FAIL at startup (fail-fast by
# design), so either complete the trio or leave the trio empty.
# ---------------------------------------------------------------------------
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_ENV=prod

# ---------------------------------------------------------------------------
# Optional: object storage for avatars (S3-compatible: R2 / S3 / MinIO).
# Leave ALL empty = uploads disabled, default avatars keep working.
# Half-filled config makes the server FAIL at startup. PUBLIC_BASE_URL must
# be HTTPS in production.
# ---------------------------------------------------------------------------
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_BUCKET=masoi-avatars
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_PUBLIC_BASE_URL=https://REPLACE_ME/masoi-avatars

# ---------------------------------------------------------------------------
# Optional: misc.
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# BOT_POLICY_FILE=
