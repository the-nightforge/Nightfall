generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id           String   @id @default(cuid())
  nickname     String
  tokenHash    String   @unique
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
}

model RoomRecord {
  id        String   @id @default(cuid())
  code      String   @unique
  hostName  String
  createdAt DateTime @default(now())
  closedAt  DateTime?
}

model GameResult {
  id          String   @id @default(cuid())
  roomCode    String
  round       Int
  winner      String
  playerRoles Json
  durationSec Int
  createdAt   DateTime @default(now())
}
