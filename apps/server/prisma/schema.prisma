generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id           String   @id @default(cuid())
  nickname     String
  tokenHash    String   @unique
  avatarUrl    String?  @db.Text
  /// Khoá của object avatar trong bucket. Nguồn sự thật DUY NHẤT cho việc xoá:
  /// server không bao giờ nhận khoá từ client, nên không ai xoá được object của
  /// người khác bằng một URL giả. avatarUrl chỉ để hiển thị.
  avatarKey    String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
}

model GameResult {
  id          String   @id @default(cuid())
  /// Khoá idempotency của MỘT ván, sinh lúc `startGame`.
  ///
  /// Nullable có chủ đích: ván ghi trước migration này không có khoá nào để
  /// gán, và Postgres cho phép nhiều NULL trong một unique index nên chúng
  /// không đụng nhau. Mọi ván mới đều có khoá, nên một ván không thể có hai
  /// dòng kết quả kể cả khi server chết đúng vào khe giữa lúc ghi DB và lúc
  /// lưu snapshot rồi ghi lại sau khi khôi phục.
  gameId      String?  @unique
  roomCode    String
  round       Int
  winner      String
  playerRoles Json
  /// Hồ sơ vụ án chốt tại lúc ván kết thúc.
  ///
  /// Nullable có chủ đích: ván ghi trước khi có cột này, và ván mà buildCaseFile
  /// trả null, đều để trống chứ không chặn việc lưu kết quả. Lịch sử vẫn đọc
  /// được khi thiếu nó - chỉ là không có phần điểm ngoặt.
  ///
  /// Lưu bản ĐÃ DỰNG chứ không dựng lại lúc đọc: nguyên liệu (nightHistory,
  /// dayVoteHistory, hunterShots) chỉ sống trong RAM của ván, không có trong DB.
  caseFile    Json?
  durationSec Int
  createdAt   DateTime @default(now())

  /// Khai ở đây để Prisma biết index này thuộc về schema.
  /// Thiếu nó thì `prisma migrate dev` coi index do migration tạo ra là drift
  /// và sinh ngay một migration xoá nó đi.
  @@index([playerRoles(ops: JsonbPathOps)], type: Gin)
}
