DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://YOUR-PROJECT.vercel.app
CHAT_MAX_LENGTH=300
CHAT_RATE_LIMIT_COUNT=5
CHAT_RATE_LIMIT_WINDOW_MS=5000

# Gioi han tao nguoi choi, khoa theo IP - endpoint duy nhat khong can dang nhap.
SIGNUP_RATE_LIMIT_COUNT=10
SIGNUP_RATE_LIMIT_WINDOW_MS=60000

# So hop proxy tin duoc (app.set("trust proxy", ...)).
# 1 = sau proxy nhu Render (mac dinh): req.ip lay tu X-Forwarded-For.
# 0 = tu host, phoi cong thang ra Internet: KHONG tin header, dung IP socket.
TRUST_PROXY=1

# Sentry (tuy chon). Bo trong thi tat han, server chay y nhu khong co Sentry.
# Chi gui loi lap trinh (khong tracing, khong IP, khong payload, khong chat).
SENTRY_DSN=

# Voice chat (LiveKit Cloud). Bo trong ca ba de tat han.
# Thieu mot nua thi server nem loi luc khoi dong thay vi am tham tat.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Vao ten room (masoi-<env>-<CODE>) de nhieu moi truong dung chung mot LiveKit.
LIVEKIT_ENV=production

# Bot AI - chuoi nha cung cap, thu lan luot tu tren xuong.
# Thieu bat ky manh nao cua mot chang thi chang do bi bo qua.
# Het ca chuoi (hoac BOT_AI_ENABLED=false) thi bot choi ngau nhien va khong chat.
BOT_AI_ENABLED=true
# Mot van 8 bot x 6 vong ton khoang 126 luot ke tu khi co phien toa.
BOT_AI_MAX_CALLS_PER_GAME=180

# 1. Chinh: endpoint OpenAI-compatible
BOT_AI_BASE_URL=
BOT_AI_API_KEY=
BOT_AI_MODEL=gemini-3.7-flash

# 2. Du phong: OpenAI chinh chu
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# 3. Du phong cuoi: Gemini goi thang Google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Object storage cho anh dai dien (S3-compatible: Cloudflare R2, AWS S3, MinIO).
# Bo trong CA SAU khoa de tat han. Dien mot phan thi server nem loi luc khoi dong.
# OBJECT_STORAGE_PUBLIC_BASE_URL phai la HTTPS khi NODE_ENV=production.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
