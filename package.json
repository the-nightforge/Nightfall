{
  "name": "ma-soi-online",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d",
    "build:shared": "npm run build --workspace @masoi/shared",
    "build:engine": "npm run build --workspace @masoi/game-engine",
    "build:server": "npm run build --workspace @masoi/server",
    "build:web": "npm run build --workspace @masoi/web",
    "build": "npm run build:shared && npm run build:engine && npm run build:server && npm run build:web",
    "build:deps": "npm run build:shared && npm run build:engine",
    "dev:server": "npm run dev --workspace @masoi/server",
    "dev:web": "npm run dev --workspace @masoi/web",
    "pretest": "npm run build:deps",
    "test": "npm run test --workspace @masoi/shared && npm run test --workspace @masoi/game-engine && npm run test --workspace @masoi/server && npm run test --workspace @masoi/web",
    "test:e2e": "tsx apps/server/scripts/e2e.ts",
    "test:e2e:recovery": "tsx apps/server/scripts/e2e-recovery.ts",
    "bot:probe": "tsx apps/server/scripts/bot-probe.ts",
    "voice:probe": "tsx apps/server/scripts/voice-probe.ts",
    "preselfplay": "npm run build:deps",
    "selfplay": "tsx apps/server/scripts/selfplay.ts",
    "pretrace-view": "npm run build:deps",
    "trace-view": "tsx apps/server/scripts/trace-view.ts",
    "prerole-power": "npm run build:deps",
    "role-power": "tsx apps/server/scripts/role-power.ts",
    "prerole-power:sweep": "npm run build:deps",
    "role-power:sweep": "tsx apps/server/scripts/role-power-sweep.ts",
    "prereveal-ab": "npm run build:deps",
    "reveal-ab": "tsx apps/server/scripts/reveal-ab.ts",
    "preai:dataset": "npm run build:deps",
    "ai:dataset": "tsx apps/server/scripts/selfplay.ts",
    "preai:encode": "npm run build:deps",
    "ai:encode": "tsx apps/server/scripts/ai-encode.ts",
    "preai:benchmark": "npm run build:deps",
    "ai:benchmark": "tsx apps/server/scripts/ai-benchmark.ts",
    "preai:validate-dataset": "npm run build:deps",
    "ai:validate-dataset": "tsx apps/server/scripts/ai-validate-dataset.ts",
    "premine-aliases": "npm run build:deps",
    "mine-aliases": "tsx apps/server/scripts/mine-aliases.ts",
    "prelint": "npm run build:deps",
    "lint": "npm run lint --workspace @masoi/shared && npm run lint --workspace @masoi/game-engine && npm run lint --workspace @masoi/web && npm run lint --workspace @masoi/server",
    "db:migrate": "npm run db:migrate --workspace @masoi/server",
    "db:generate": "npm run db:generate --workspace @masoi/server"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
