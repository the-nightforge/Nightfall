{
  "name": "ma-soi-online",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:infra": "docker compose up -d",
    "build:shared": "npm run build --workspace @masoi/shared",
    "build:engine": "npm run build --workspace @masoi/game-engine",
    "build:server": "npm run build --workspace @masoi/server",
    "build:web": "npm run build --workspace @masoi/web",
    "build": "npm run build:shared && npm run build:engine && npm run build:server && npm run build:web",
    "dev:server": "npm run dev --workspace @masoi/server",
    "dev:web": "npm run dev --workspace @masoi/web",
    "test": "npm run test --workspace @masoi/game-engine",
    "test:e2e": "tsx apps/server/scripts/e2e.ts",
    "lint": "npm run lint --workspace @masoi/web && npm run lint --workspace @masoi/server",
    "db:migrate": "npm run db:migrate --workspace @masoi/server",
    "db:generate": "npm run db:generate --workspace @masoi/server"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
