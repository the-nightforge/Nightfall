# Template cho /opt/masoi/.env trên VPS. Copy lên rồi `chmod 600`.
# KHÔNG commit file đã điền secret.
#
# Sinh password mạnh: openssl rand -base64 32 | tr -d '/+=' | head -c 32

# ---------------------------------------------------------------- Database
# Password này được docker-compose.prod.yml dùng để khởi tạo Postgres VÀ phải
# khớp với chuỗi trong DATABASE_URL. Đổi một chỗ mà quên chỗ kia = server không
# kết nối được DB và /api/health trả 503.
POSTGRES_PASSWORD=THAY_BANG_PASSWORD_MANH_32_KY_TU

# Host là `postgres` (tên service trong docker network), KHÔNG phải localhost:
# localhost bên trong container là chính container server.
DATABASE_URL=postgresql://masoi:THAY_BANG_PASSWORD_MANH_32_KY_TU@postgres:5432/masoi?schema=public

# ------------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379

# Origin công khai của trang. Web và API cùng origin nên hai biến này bằng nhau.
# ĐỔI GIÁ TRỊ NÀY BẮT BUỘC BUILD LẠI image web (nướng vào bundle lúc build).
PUBLIC_ORIGIN=https://masoionline.duckdns.org

# ------------------------------------------------------------------ Server
PORT=4100
NODE_ENV=production

# Origin CHÍNH XÁC của frontend. Ở production server sẽ NÉM LỖI lúc khởi động
# nếu để `*` (apps/server/src/config.ts:107). Nhiều origin thì cách nhau bằng
# dấu phẩy. Không có dấu / ở cuối.
CORS_ORIGIN=https://masoionline.duckdns.org

# 1 = chạy sau Nginx, req.ip lấy từ X-Forwarded-For. Để 0 là rate limit theo IP
# sẽ khoá nhầm — mọi request đều mang IP của Nginx.
TRUST_PROXY=1

# --------------------------------------------------------- Chống spam chat
CHAT_MAX_LENGTH=300
CHAT_RATE_LIMIT_COUNT=5
CHAT_RATE_LIMIT_WINDOW_MS=5000
SIGNUP_RATE_LIMIT_COUNT=10
SIGNUP_RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------ Bot AI (BẬT)
# Thiếu key thì bot rơi về heuristic, không lỗi nhưng cũng không dùng LLM.
GEMINI_API_KEY=THAY_BANG_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
BOT_AI_ENABLED=true
BOT_AI_MAX_CALLS_PER_GAME=180

# Learned policy PPO đóng gói sẵn trong image. Bỏ trống = bot heuristic thuần.
# Đặt mà file hỏng/lệch schema thì server KHÔNG khởi động được (cố ý).
BOT_POLICY_FILE=apps/server/assets/models/village-ppo-0001.weights.json
# Trong = mac dinh 0.5; 0 = argmax (rollback). Xem .env.example.
BOT_POLICY_TEMPERATURE=

# ------------------------------------------------------- Voice chat (BẬT)
# Phải đủ CẢ BA. Điền một nửa thì server ném lỗi lúc khởi động
# (apps/server/src/config.ts:135) — đây là hành vi cố ý, không phải bug.
LIVEKIT_URL=wss://THAY_BANG_PROJECT.livekit.cloud
LIVEKIT_API_KEY=THAY_BANG_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=THAY_BANG_LIVEKIT_API_SECRET
# Tên room là masoi-<env>-<CODE>; để "prod" cho khỏi đụng phòng dev.
LIVEKIT_ENV=prod

# --------------------------------------------- Avatar upload — R2 (BẬT)
# Phải đủ CẢ SÁU. Điền một phần thì server ném lỗi lúc khởi động
# (apps/server/src/storage/config.ts:47).
#
# Dùng Cloudflare R2 chứ không tự host MinIO: PUBLIC_BASE_URL bắt buộc HTTPS ở
# production, mà cấp HTTPS cho MinIO tự host thì cần thêm domain + cert.
OBJECT_STORAGE_ENDPOINT=https://THAY_BANG_ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=masoi-avatars
OBJECT_STORAGE_ACCESS_KEY_ID=THAY_BANG_R2_ACCESS_KEY_ID
OBJECT_STORAGE_SECRET_ACCESS_KEY=THAY_BANG_R2_SECRET_ACCESS_KEY
# URL công khai mà trình duyệt tải ảnh — KHÁC endpoint ký ở trên.
# Bật "Public Development URL" của bucket trên R2 để lấy, hoặc gắn custom domain.
OBJECT_STORAGE_PUBLIC_BASE_URL=https://pub-THAY_BANG_HASH.r2.dev

# ------------------------------------------------------ Sentry (tuỳ chọn)
SENTRY_DSN=

# Origin thêm cho connect-src của CSP trên web. LiveKit Cloud (*.livekit.cloud)
# đã được cho sẵn nên thường để trống.
CSP_CONNECT_SRC_EXTRA=
